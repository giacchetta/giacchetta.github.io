---
import { render } from 'astro:content';
import { cleanSlug } from '../utils/content.js';
import { useTranslations } from '../i18n/utils';

interface Props {
  post: any;
  linked?: boolean;
  headingTag?: 'h1' | 'h2';
}

const { post, linked = false, headingTag = 'h2' } = Astro.props;
const Heading = headingTag;
const { Content } = await render(post);
const t = useTranslations();

const dateLocale = 'en-US';
const formattedDate = new Date(post.data.date).toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<header class="mb-3">
  <Heading class={headingTag === 'h1' ? 'display-6 fw-bold text-primary mb-1' : 'h3 fw-bold text-primary mb-1'}>
    {linked ? (
      <a href={`/blog/${cleanSlug(post)}/`} class="text-decoration-none">{post.data.title}</a>
    ) : (
      post.data.title
    )}
  </Heading>
  <div class="text-muted small mb-2">{formattedDate}</div>
  {(post.data.tags.length > 0 || post.data.pr) && (
    <div class="d-flex flex-wrap gap-2">
      {post.data.tags.map((tag: string) => (
        <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill">{tag}</span>
      ))}
      {post.data.pr && (
        <a
          href={post.data.pr}
          target="_blank"
          rel="noopener noreferrer"
          class="badge bg-primary-subtle text-primary-emphasis border rounded-pill text-decoration-none"
        >
          {t('blog.viewPr')} ↗
        </a>
      )}
    </div>
  )}
</header>

<div class="content">
  <Content />
</div>

<style>
  .content {
    line-height: 1.7;
  }

  .content :global(h2) {
    color: var(--bs-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .content :global(h3) {
    color: var(--bs-body-color);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .content :global(p) {
    text-align: justify;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(blockquote) {
    border-left: 4px solid var(--bs-primary);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--bs-secondary);
  }

  .content :global(code) {
    background-color: var(--bs-tertiary-bg);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
  }

  .content :global(pre) {
    background-color: var(--bs-dark);
    color: var(--bs-light);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
</style>
