---
import { render } from 'astro:content';
import Prose from './Prose.astro';
import { cleanSlug, getExcerpt } from '../utils/content.js';
import { formatDate } from '../utils/date.js';
import { useTranslations } from '../i18n/utils';

interface Props {
  post: any;
  linked?: boolean;
  headingTag?: 'h1' | 'h2';
  /** Feed mode: render title/tags/description + "Read more" instead of the full body. */
  summary?: boolean;
}

const { post, linked = false, headingTag = 'h2', summary = false } = Astro.props;
const Heading = headingTag;
const Content = summary ? null : (await render(post)).Content;
const description = post.data.description || getExcerpt(post);
const t = useTranslations();

const formattedDate = formatDate(post.data.date);
const isoDate = new Date(post.data.date).toISOString();
---

<header class="mb-3">
  <Heading class={headingTag === 'h1' ? 'display-6 fw-bold text-primary mb-1' : 'h3 fw-bold text-primary mb-1'}>
    {linked ? (
      <a href={`/blog/${cleanSlug(post)}/`} class="text-decoration-none">{post.data.title}</a>
    ) : (
      post.data.title
    )}
  </Heading>
  <div class="text-muted small mb-2"><time datetime={isoDate}>{formattedDate}</time></div>
  {(post.data.tags.length > 0 || post.data.pr) && (
    <div class="d-flex flex-wrap gap-2">
      {post.data.tags.map((tag: string) => (
        <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill">{tag}</span>
      ))}
      {post.data.pr && (
        <a
          href={post.data.pr}
          target="_blank"
          rel="noopener noreferrer"
          class="badge bg-primary-subtle text-primary-emphasis border rounded-pill text-decoration-none"
        >
          {t('blog.viewPr')} ↗
        </a>
      )}
    </div>
  )}
</header>

{summary ? (
  <>
    <p class="mb-2">{description}</p>
    <a href={`/blog/${cleanSlug(post)}/`} class="text-decoration-none small text-primary">
      {t('blog.readMore')} &rarr;
    </a>
  </>
) : (
  <Prose>
    <Content />
  </Prose>
)}
