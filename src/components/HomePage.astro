---
import { Picture, Image } from 'astro:assets';
import Profile from '../assets/img/profile.png';
import Layout from '../layouts/Layout.astro';
import { getAllPages, getFeaturedPagesByCategory, getBlogPosts, cleanSlug } from '../utils/content.js';
import { formatDate, periodStartYear } from '../utils/date.js';
import { homeGraph } from '../utils/seo.js';
import { useTranslations } from '../i18n/utils';
import { skillNames, skillDomains, skillProducts } from '../utils/skills.js';
import featuredProjects from '../data/projects.json';
import gmailIcon from '../assets/svg/gmail.svg?raw';
import phoneIcon from '../assets/svg/phone.svg?raw';
import whatsappIcon from '../assets/svg/whatsapp.svg?raw';
import linkedinIcon from '../assets/svg/linkedin.svg?raw';
import githubIcon from '../assets/svg/github.svg?raw';
import youtubeIcon from '../assets/svg/youtube.svg?raw';

const t = useTranslations();
const pages = await getAllPages();

const breadcrumbs = [{ label: t('nav.home') }];

const featuredCaseStudies = getFeaturedPagesByCategory(pages, 'collaborations')
  .filter(p => p.data.type === 'article')
  .sort((a, b) => new Date(b.data.publishDate ?? 0) - new Date(a.data.publishDate ?? 0))
  .slice(0, 2);

const companies = pages.collaborations.filter(p => p.data.type === 'company');

const recentRoles = companies
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const allPosts = await getBlogPosts();
const latestPosts = allPosts.slice(0, 3);

// Terminals tile panes — everything below is derived from content already on the
// site, so the numbers can't drift out of date (see AGENTS.md Tile 2).
const careerStart = Math.min(
  ...companies.map(c => periodStartYear(c.data.period)).filter(Boolean)
);
const yearsExperience = new Date().getFullYear() - careerStart;
const currentRoles = companies
  .filter(c => c.data.period?.trim().endsWith('Present'))
  .sort((a, b) => periodStartYear(b.data.period) - periodStartYear(a.data.period));

// Structured data (Person + WebSite + ProfilePage) — sourced from the same
// content already driving the visible page, so it can't drift out of sync.
const sameAsLinks = [
  'https://www.linkedin.com/in/giacchetta/',
  'https://github.com/giacchetta',
  'https://www.youtube.com/@LucianoGiacchetta',
];
const knowsAbout = skillNames();
const worksFor = currentRoles.map((role) => ({ '@type': 'Organization', name: role.data.title }));
const homeJsonLd = homeGraph({
  jobTitle: t('site.jobTitle'),
  brand: t('site.brand'),
  sameAs: sameAsLinks,
  worksFor,
  knowsAbout,
  description: t('meta.descriptionHome'),
});

const domains = skillDomains();
const skillNameWidth = Math.max(...domains.map(d => d.slug.length)) + 1;
const skillsTableText = [
  `${'NAME'.padEnd(skillNameWidth)}${'SKILLS'.padStart(6)}  ${'STATUS'.padStart(6)}`,
  ...domains.map(d =>
    `${d.slug.padEnd(skillNameWidth)}${String(d.count).padStart(6)}  ${'Ready'.padStart(6)}`
  ),
].join('\n');

const badgeStyles = [
  'bg-warning-subtle text-warning-emphasis border',
  'bg-primary-subtle text-primary border',
  'bg-info-subtle text-info-emphasis border',
  'bg-secondary-subtle text-secondary-emphasis border',
  'bg-success-subtle text-success border',
  'bg-danger-subtle text-danger border',
  'bg-dark text-white',
];

const techStack = skillProducts().map((name, i) => ({ name, style: badgeStyles[i % badgeStyles.length] }));
---

<Layout title={t('site.title')} description={t('meta.descriptionHome')} suffix={false} jsonLd={homeJsonLd}>
  <main class="container layout home-main mt-3 mb-5">
    <div class="row g-4 bento-grid">

      <!-- Tile 1: Profile — first on every breakpoint (phone, tablet, desktop). -->
      <div class="col-12 col-md-4 t-profile">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4 h-100 d-flex flex-column justify-content-center gap-3">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <h1 class="fs-3 fw-bold mb-0 text-center">{t('bio.name')}</h1>
            <span class="fs-3 lh-1" aria-hidden="true">🧑‍💻</span>
          </div>
          <div class="row g-3 align-items-center align-self-center">
            <div class="col-5 d-flex justify-content-center">
              <Picture
                src={Profile}
                alt="Luciano Giacchetta"
                width={120}
                height={120}
                class="rounded-circle shadow-sm"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="col-7 icon-grid">
              <button
                type="button"
                class="btn icon-btn icon-btn-brand"
                data-bs-toggle="modal"
                data-bs-target="#contactModal"
                aria-label={t('hero.emailCta')}
                title={t('hero.emailCta')}
                set:html={gmailIcon}
              />
              <button
                type="button"
                class="btn icon-btn icon-btn-brand"
                data-bs-toggle="modal"
                data-bs-target="#phoneModal"
                aria-label={t('hero.phoneCta')}
                title={t('hero.phoneCta')}
                set:html={phoneIcon}
              />
              <a
                href="https://wa.me/luciano.giacchetta"
                target="_blank"
                rel="noopener noreferrer"
                class="btn icon-btn icon-btn-brand"
                aria-label={`${t('hero.whatsappCta')} (opens in a new tab)`}
                title={t('hero.whatsappCta')}
                set:html={whatsappIcon}
              />
              <a
                href="https://www.linkedin.com/in/giacchetta/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn icon-btn icon-btn-brand"
                aria-label={`${t('hero.linkedinCta')} (opens in a new tab)`}
                title={t('hero.linkedinCta')}
                set:html={linkedinIcon}
              />
              <a
                href="https://github.com/giacchetta"
                target="_blank"
                rel="noopener noreferrer"
                class="btn icon-btn icon-btn-brand"
                aria-label={`${t('hero.githubCta')} (opens in a new tab)`}
                title={t('hero.githubCta')}
                set:html={githubIcon}
              />
              <a
                href="https://www.youtube.com/@LucianoGiacchetta"
                target="_blank"
                rel="noopener noreferrer"
                class="btn icon-btn icon-btn-brand"
                aria-label={`${t('hero.youtubeCta')} (opens in a new tab)`}
                title={t('hero.youtubeCta')}
                set:html={youtubeIcon}
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Tile 2: Terminals -->
      <div class="col-12 col-md-8 t-terminals">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4 h-100">
          <div class="row g-3 h-100">
            <!-- Career pane -->
            <div class="col-12 col-lg-6 d-flex">
              <div class="term rounded-3 p-3 h-100 w-100 d-flex flex-column">
                <h2 class="visually-hidden">{t('hero.careerPaneLabel')}</h2>
                <div class="d-flex align-items-center gap-2 mb-2">
                  <span class="term-dot bg-danger" aria-hidden="true"></span>
                  <span class="term-dot bg-warning" aria-hidden="true"></span>
                  <span class="term-dot bg-success" aria-hidden="true"></span>
                  <span class="ms-auto small text-secondary">~/career</span>
                </div>
                <div class="font-monospace small">
                  <div><span class="text-success">$</span> whoami</div>
                  <div class="mb-2">{t('hero.terminalRole')}</div>
                  <div><span class="text-success">$</span> uptime</div>
                  <div class="mb-2">up {yearsExperience} years, {companies.length} companies, since {careerStart}</div>
                  <div><span class="text-success">$</span> jobs</div>
                  {currentRoles.map((role, i) => (
                    <div>[{i + 1}]+ {role.data.title} running since {periodStartYear(role.data.period)}</div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Stack pane -->
            <div class="col-12 col-lg-6 d-flex">
              <div class="term rounded-3 p-3 h-100 w-100 d-flex flex-column">
                <h2 class="visually-hidden">{t('hero.stackPaneLabel')}</h2>
                <div class="d-flex align-items-center gap-2 mb-2">
                  <span class="term-dot bg-danger" aria-hidden="true"></span>
                  <span class="term-dot bg-warning" aria-hidden="true"></span>
                  <span class="term-dot bg-success" aria-hidden="true"></span>
                  <span class="ms-auto small text-secondary">~/stack</span>
                </div>
                <div class="font-monospace small">
                  <div><span class="text-success">$</span> kubectl get skills</div>
                  <pre class="mb-2 overflow-x-auto">{skillsTableText}</pre>
                  <div><span class="text-success">$</span> helm list --filter posts</div>
                  <div>blog   deployed   {allPosts.length} posts</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tile 3: Latest Posts -->
      <div class="col-12 col-md-6 d-flex t-posts">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4 h-100 w-100 d-flex flex-column tile-tall">
          <h2 class="h5 fw-bold text-muted mb-3">{t('hero.latestPosts')}</h2>
          <div class="d-flex flex-column gap-2 flex-grow-1">
            {latestPosts.map((post) => (
              <a
                href={`/blog/${cleanSlug(post)}/`}
                class="text-decoration-none text-body p-2 rounded-3 tile-row"
              >
                <div class="fw-semibold">{post.data.title}</div>
                <small class="text-muted">
                  {formatDate(post.data.date)}
                </small>
              </a>
            ))}
          </div>
          {latestPosts.length > 0 && (
            <div class="text-end mt-3">
              <a href="/blog/" class="text-decoration-none small text-primary">
                {t('hero.viewAllPosts')} &rarr;
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Tile 4: Tech Stack Matrix -->
      <div class="col-12 col-md-6 t-stack">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4 h-100 d-flex flex-column tile-tall">
          <h2 class="h5 fw-bold text-muted mb-3">{t('hero.techStack')}</h2>
          <div class="d-flex flex-wrap gap-2 flex-grow-1 align-content-start">
            {techStack.map((skill) => (
              <span class={`badge rounded-pill px-3 py-2 ${skill.style}`}>{skill.name}</span>
            ))}
          </div>
          <div class="text-end mt-3">
            <a href="/credentials/" class="text-decoration-none small text-primary">
              {t('hero.viewFullStack')} &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Tile 5: Case Studies -->
      {featuredCaseStudies.length > 0 && (
        <div class="col-12 col-md-4 t-cases">
          <div class="bento-tile bg-primary-subtle rounded-5 shadow-sm p-4 h-100 d-flex flex-column">
            <span class="badge bg-primary text-white rounded-pill mb-3 align-self-start">{t('hero.featuredCaseStudies')}</span>
            <div class="d-flex flex-column gap-2 flex-grow-1">
              {featuredCaseStudies.map((study) => (
                <a
                  href={`/experience/${cleanSlug(study)}/`}
                  class="text-decoration-none text-body p-2 rounded-3 tile-row"
                >
                  <div class="fw-semibold">{study.data.title}</div>
                  {study.data.description && (
                    <small class="text-muted case-study-desc">
                      {study.data.description.replace(/^Case Study:\s*/i, '')}
                    </small>
                  )}
                </a>
              ))}
            </div>
            <div class="text-end mt-3">
              <a href="/experience/#detailed-case-studies" class="text-decoration-none small text-primary">
                {t('hero.viewAllCaseStudies')} &rarr;
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- Tile 6: Recent Experience -->
      <div class="col-12 col-md-8 t-roles">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4 h-100 d-flex flex-column">
          <h2 class="h5 fw-bold text-muted mb-3">{t('hero.recentRoles')}</h2>
          <div class="d-flex flex-column gap-3 flex-grow-1">
            {recentRoles.map((role) => (
              <a
                href={`/experience/${cleanSlug(role)}/`}
                class="d-flex align-items-center gap-3 text-decoration-none text-body p-2 rounded-3 tile-row"
              >
                {role.data.logo && (
                  <Image
                    src={role.data.logo}
                    alt={role.data.title}
                    style="max-height: 48px; max-width: 64px; object-fit: contain;"
                    class="rounded-2 flex-shrink-0"
                  />
                )}
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold text-truncate">{role.data.title}</div>
                  <small class="text-muted">{role.data.role} · {role.data.period}</small>
                </div>
              </a>
            ))}
          </div>
          <div class="text-end mt-3">
            <a href="/experience/" class="btn btn-outline-secondary btn-sm">
              {t('hero.viewFullExperience')}
            </a>
          </div>
        </div>
      </div>

      <!-- Tile 7: Featured Projects (data-driven — add entries to src/data/projects.json) -->
      <div class="col-12 t-projects">
        <div class="bento-tile bg-body-tertiary rounded-5 shadow-sm p-4">
          <h2 class="h5 fw-bold text-muted mb-3">{t('hero.featuredProjects')}</h2>
          <div class="d-flex flex-column gap-2">
            {featuredProjects.map((project) => (
              <div>
                <a
                  href={project.href}
                  class="d-flex align-items-center gap-3 text-decoration-none text-body p-2 rounded-3 tile-row h-100"
                >
                  <span class="fs-1 flex-shrink-0" aria-hidden="true">{project.emoji}</span>
                  <div class="flex-grow-1 min-w-0">
                    <div class="fw-semibold">{project.title} &rarr;</div>
                    <small class="text-muted">{project.description}</small>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Desktop "one screen" Bento: from 1200x700 up (covers a 1080p panel at 125%
     scaling, i.e. 1536x864 minus browser chrome) the grid fills the viewport so
     every tile is visible without scrolling. Overflowing tile content is clipped
     / scrolled inside its tile. Below that, Bootstrap's stacked/flowing layout. */
  @media (min-width: 1200px) and (min-height: 700px) {
    .home-main {
      max-width: 94%;
    }
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 0.97fr);
      gap: 1rem;
      grid-template-areas:
        "prof prof prof prof term term term term term term term term"
        "posts posts posts posts stack stack stack stack proj proj proj proj"
        "cases cases cases cases roles roles roles roles roles roles roles roles";
      height: calc(100dvh - 3.5rem);
      margin: 0;
      --bs-gutter-x: 1.5rem;
    }
    .bento-grid > * {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      min-height: 0;
    }
    .bento-grid .tile-tall {
      min-height: 0;
    }
    .bento-grid .bento-tile {
      overflow: auto;
      padding: 1rem 1.25rem !important;
    }
    /* Keep each tile's "View all" footer link pinned; clip the list instead. */
    .bento-grid .bento-tile {
      overflow: hidden;
    }
    .bento-grid .bento-tile > .flex-grow-1 {
      min-height: 0;
      overflow: hidden;
    }
    .bento-grid .bento-tile .tile-row {
      padding: 0.25rem 0.5rem !important;
    }
    .bento-grid .bento-tile > .flex-grow-1 {
      gap: 0.25rem !important;
    }
    .bento-grid .bento-tile h2.h5 {
      margin-bottom: 0.5rem !important;
    }
    .bento-grid .t-profile .bento-tile {
      gap: 0.5rem !important;
    }
    /* Shorter viewports (e.g. 1536x864 minus browser chrome): trim list rows
       so nothing is cut mid-item. */
    @media (max-height: 800px) {
      .t-posts .tile-row .fw-semibold {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .t-cases .tile-row:nth-child(n + 2) {
        display: none !important;
      }
      .t-roles .tile-row small {
        display: none !important;
      }
      .t-roles img {
        max-height: 32px !important;
      }
      .t-posts .tile-row:nth-child(n + 3) {
        display: none !important;
      }
      .t-stack .badge:nth-last-child(-n + 6) {
        display: none !important;
      }
      .t-stack .badge {
        padding-top: 0.25em !important;
        padding-bottom: 0.25em !important;
      }
    }
    .t-roles .tile-row:nth-child(n + 3) {
      display: none !important;
    }
    .t-profile { grid-area: prof; }
    .t-terminals { grid-area: term; }
    .t-posts { grid-area: posts; }
    .t-stack { grid-area: stack; }
    .t-projects { grid-area: proj; }
    .t-cases { grid-area: cases; }
    .t-roles { grid-area: roles; }
  }
  .bento-tile {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bento-tile:hover {
    transform: scale(1.02);
    box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.12) !important;
  }
  .tile-row {
    transition: background-color 0.2s ease;
  }
  .tile-row:hover {
    background-color: var(--bs-tertiary-bg);
  }
  .case-study-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile-tall {
    min-height: 320px;
  }
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(3, 42px);
    gap: 0.5rem;
    justify-content: center;
    align-content: center;
    min-height: 120px;
  }
  .icon-btn {
    width: 42px;
    height: 42px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .icon-btn :global(svg) {
    width: 22px;
    height: 22px;
  }
  .icon-btn-brand {
    background-color: var(--bs-tertiary-bg);
    border: 1px solid var(--bs-border-color);
  }
  .icon-btn-brand:hover {
    background-color: var(--bs-secondary-bg);
  }
  .term {
    background-color: #0d1117;
    border: 1px solid var(--bs-border-color);
  }
  .term-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .term .font-monospace {
    font-size: clamp(0.68rem, 2.6vw, 0.8rem);
  }
  .term pre {
    margin: 0;
  }
</style>


