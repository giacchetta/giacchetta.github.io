---
import Contact from './Contact.astro';
import Phone from './Phone.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations();
const date = new Date();
---
<footer class="text-center py-1">
	<small class="text-muted">{t('footer.lastUpdate')} {date.toDateString()}</small>
</footer>
<!-- Modals rendered outside the fixed navbar to avoid stacking context issues -->
<Contact />
<Phone />
