---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { cleanSlug } from '../utils/content.js';
import { skillSections, credentialSlugSet, caseStudiesForSkillId } from '../utils/skills.js';

const t = useTranslations();

const credentialSections = skillSections().map(({ title, entries }) => ({ title, data: entries }));

const credentialSlugs = await credentialSlugSet();

// Direct id-based reverse lookup, independent of `credentialPage` — this is
// what lets the full matrix link back to a case study for any referenced
// skill, not only the couple that also have a dedicated deep-dive page.
const allCollaborations = (await getCollection('collaborations')).filter((p: any) => !p.data.draft);
---
<h2>{t('credentials.heading')}</h2>

{credentialSections.map((section) => (
  <div class="mb-4">
    <h3>{section.title}</h3>
    <div class="row">
      {section.data &&
        section.data.map((entry) => {
          const usedIn = caseStudiesForSkillId(entry.id, allCollaborations);
          return (
          <div class="col-12 col-sm-6 col-lg-4 mb-3" id={entry.id}>
            <div class="card shadow-sm h-100">
              <div class="card-body d-flex flex-column p-3">
                <div class="mb-2">
                  <span class="badge bg-primary-subtle text-primary">{entry.product}</span>
                </div>
                <h6 class="card-title mb-2">
                  {entry.credentialPage && credentialSlugs.has(entry.credentialPage) ? (
                    <a href={`/credentials/${entry.credentialPage}/`} class="text-decoration-none">{entry.name}</a>
                  ) : entry.namelnk === '#' ? (
                    entry.name
                  ) : (
                    <a href={entry.namelnk} class="text-decoration-none">{entry.name}</a>
                  )}
                </h6>
                <div class="mt-auto">
                  {usedIn.length > 0 && (
                    <div class="mb-2 d-flex flex-column gap-1">
                      <span class="text-muted small">{t('credentials.usedIn')}</span>
                      {usedIn.map((article: any) => (
                        <a href={`/experience/${cleanSlug(article)}/`} class="small text-decoration-none">
                          {article.data.title}
                        </a>
                      ))}
                    </div>
                  )}
                  {entry.typelnk === '#'
                    ? <span class="badge bg-secondary-subtle text-secondary">{entry.type}</span>
                    : <a href={entry.typelnk} class="badge bg-secondary-subtle text-secondary text-decoration-none">{entry.type}</a>
                  }
                </div>
              </div>
            </div>
          </div>
          );
        })}
    </div>
  </div>
))}
