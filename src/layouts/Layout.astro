---
import Favicon from '../assets/img/favicon.png';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import { breadcrumbList } from '../utils/seo.js';
import '../styles/bootstrap.min.css';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	/** Page-specific title only — Layout appends " | {bio.name}" unless `suffix` is false. */
	title: string;
	description?: string;
	/** Set false only for the homepage, whose title already contains the full brand line. */
	suffix?: boolean;
	ogType?: 'website' | 'article';
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	/** Same shape as the visible Bootstrap breadcrumb; rendered as BreadcrumbList JSON-LD. */
	breadcrumbs?: Crumb[];
	/** Additional structured-data node(s) for this page (e.g. BlogPosting, TechArticle, or the home Person/WebSite graph). */
	jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
	title,
	description,
	suffix = true,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	breadcrumbs,
	jsonLd,
} = Astro.props;
const t = useTranslations();

const path = Astro.url.pathname;
const siteBase = Astro.site!.origin;
const canonicalURL = `${siteBase}${path}`;
const ogImage = `${siteBase}/og.png`;

const metaDescription = description || t('meta.description');
const pageTitle = suffix ? `${title} | ${t('bio.name')}` : title;

const jsonLdBlocks = [
	...(breadcrumbs?.length ? [breadcrumbList(breadcrumbs)] : []),
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en" data-bs-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="author" content={t('bio.name')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={Favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={t('bio.name')} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('bio.name')} />
		{ogType === 'article' && publishedTime && (
			<meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
		)}
		{ogType === 'article' && modifiedTime && (
			<meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<title>{pageTitle}</title>
		{jsonLdBlocks.map((block) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
		))}
	</head>
	<body>
		<slot />
		<Footer />
	</body>
</html>
<script>
	import 'bootstrap/dist/js/bootstrap.js';
</script>
<style is:global>
	body {
		overflow-x: clip;
	}

	@media (min-width: 992px) {
	.layout {
		max-width: 75%;
		}
	}

	@media (min-width: 1400px) {
	.layout {
		max-width: 65%;
		}
	}
</style>
