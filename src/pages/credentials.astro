---
import Layout from '../layouts/Layout.astro';
import Credentials from '../components/Credentials.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations();
---
<Layout title={`${t('credentials.pageTitle')} | ${t('bio.name')}`}>
  <main class="container layout mt-3 mb-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="/">{t('nav.home')}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{t('nav.credentials')}</li>
      </ol>
    </nav>
    <h1 class="display-5 fw-bold mb-4">{t('credentials.pageTitle')}</h1>
    <Credentials/>
  </main>
</Layout>
