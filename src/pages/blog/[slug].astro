---
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { getBlogPosts, getExcerpt } from '../../utils/content.js';
import { blogPosting } from '../../utils/seo.js';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const t = useTranslations();
const description = post.data.description || getExcerpt(post);

const breadcrumbs = [
  { label: t('nav.home'), href: '/' },
  { label: t('nav.blog'), href: '/blog/' },
  { label: post.data.title },
];

const postUrl = `https://lucianogiacchetta.com/blog/${post.id}/`;
const postJsonLd = blogPosting({
  title: post.data.title,
  description,
  datePublished: post.data.date,
  tags: post.data.tags,
  url: postUrl,
  image: 'https://lucianogiacchetta.com/og.png',
});
---
<Layout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  breadcrumbs={breadcrumbs}
  jsonLd={postJsonLd}
>
  <main class="container layout mt-3 mb-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-3">
        {breadcrumbs.map((crumb, i) => (
          i < breadcrumbs.length - 1
            ? <li class="breadcrumb-item"><a href={crumb.href}>{crumb.label}</a></li>
            : <li class="breadcrumb-item active" aria-current="page">{crumb.label}</li>
        ))}
      </ol>
    </nav>

    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <BlogPost post={post} headingTag="h1" />
      </div>
    </div>
  </main>
</Layout>
